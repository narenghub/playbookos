node_modules/
*.db
*.db-shm
*.db-wal
.env
scripts/seed-real-data.js
scripts/sync-abiozen-products.js
public/linkedin-images/

# Generated call sheets contain prospect contact data — keep them out of git.
docs/acbm-call-sheet-*.md

# Generated data exports. They are regenerated from the database on demand, and
# some carry supplier, trial-sponsor or prospect data that does not belong in git
# history — where deletion does not remove it and every clone keeps a copy.
/approved.csv
/approved-products.json
/supplier-products.csv
/paul-*.csv
/log

# UI rendering evidence — regenerate with scripts/screenshot-prpa-page.js
ui-evidence/

# Database dumps. NEVER in this tree: the repository is public, and a dump holds the users table with
# its password hashes, every prospect and contact, and the integrations table. On 2026-11-06 three
# production dumps sat here untracked with no pattern to catch them — nothing had been committed, so
# it stayed a near miss. Keep them in ~/db-backups, outside the repository.
# scripts/check-no-database-dumps.js is the half that holds when someone uses `git add -f`.
*.dump
*.pgdump
*.sql.gz
*.sql.bz2
*.sql.zst
*.bak

# Database server certificates fetched for CLI pinning (scripts/fetch-db-cert.sh).
# Not secret, but operational files do not belong in a public repo — see check-no-database-dumps.js
*.crt
*.pem
db-server.crt
