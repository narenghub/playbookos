#!/usr/bin/env bash
# ── PlayNexa worker control ──────────────────────────────────────────────────
#
#   workerctl install   <api-base-url> <worker-id>   write the LaunchAgent and load it
#   workerctl enroll    <worker-id>                  exchange an enrollment token for a secret
#   workerctl start | stop | restart | status | logs | doctor | uninstall
#
# ── WRITTEN BUT NOT EXECUTED ON APPLE HARDWARE ──────────────────────────────
#
# Every line below was syntax-checked with `bash -n` and the plist it generates was parsed, both on
# LINUX. Nothing here has run on macOS. `launchctl`, `security` and `sysadminctl` do not exist in
# that environment, so their invocations are unverified by execution and must be treated as
# untested until somebody runs them on the machine. Said plainly because an installer that LOOKS
# tested is worse than one that admits it is not.
#
# ── IT WILL NOT CREATE THE ACCOUNT FOR YOU ──────────────────────────────────
#
# Creating a macOS user needs admin rights, and a script that quietly creates an account is a
# script that quietly creates an account. The owner does that once, by hand, and this refuses to
# run as root or as an admin so it cannot be the thing that did it.
#
# ── IT ENABLES NOTHING INBOUND ──────────────────────────────────────────────
#
# No SSH, no Remote Management, no Screen Sharing, no firewall change, no port. The worker only
# makes outbound connections. If a future version of this file needs an inbound anything, that is
# a design change and not an installer detail.

set -uo pipefail

LABEL="ai.playnexa.worker"
PLIST="$HOME/Library/LaunchAgents/${LABEL}.plist"
LOG_DIR="$HOME/Library/Logs/playnexa-worker"
HERE="$(cd "$(dirname "$0")" && pwd)"
WORKER_DIR="$(cd "$HERE/../.." && pwd)"
TEMPLATE="$HERE/${LABEL}.plist.template"

die() { printf 'error: %s\n' "$*" >&2; exit 1; }
say() { printf '%s\n' "$*"; }

require_macos() {
  [ "$(uname -s)" = "Darwin" ] || die "this runs on macOS only; this is $(uname -s)"
}

# Refuses root AND admin. The worker account should be a plain user: if it is in the admin group,
# anything that compromises the worker has local administrative rights on the machine.
refuse_privilege() {
  [ "$(id -u)" != "0" ] || die "do not run this as root. The worker is a plain user account."
  if id -Gn 2>/dev/null | tr ' ' '\n' | grep -qx admin; then
    die "$(id -un) is in the 'admin' group. Create a dedicated NON-admin account for the worker and run this as that account. See installer/macos/README.md."
  fi
}

uid_target() { printf 'gui/%s' "$(id -u)"; }

cmd_install() {
  require_macos; refuse_privilege
  local url="${1:-}" wid="${2:-}"
  [ -n "$url" ] && [ -n "$wid" ] || die "usage: workerctl install <api-base-url> <worker-id>"
  case "$url" in https://*) ;; *) die "the API base URL must be https://" ;; esac
  case "$wid" in wkr_*) ;; *) die "the worker id must look like wkr_<32 hex>" ;; esac

  local node_bin; node_bin="$(command -v node)" || die "node is not on PATH"
  [ -f "$TEMPLATE" ] || die "missing template: $TEMPLATE"

  mkdir -p "$LOG_DIR" "$HOME/Library/LaunchAgents" || die "could not create the log or LaunchAgents directory"

  # Written to a temp file and moved, so an interrupted install never leaves a half-written plist
  # that launchd would then refuse in a confusing way.
  local tmp; tmp="$(mktemp)" || die "mktemp failed"
  sed -e "s|__NODE_BIN__|${node_bin}|g" \
      -e "s|__WORKER_DIR__|${WORKER_DIR}|g" \
      -e "s|__API_BASE_URL__|${url}|g" \
      -e "s|__WORKER_ID__|${wid}|g" \
      -e "s|__LOG_DIR__|${LOG_DIR}|g" \
      "$TEMPLATE" > "$tmp" || die "could not render the plist"

  plutil -lint "$tmp" >/dev/null || { rm -f "$tmp"; die "the rendered plist is not valid"; }
  mv "$tmp" "$PLIST" || die "could not install the plist"
  chmod 644 "$PLIST"
  say "wrote $PLIST"

  # Idempotent: bootout first, ignoring the failure when it was not loaded.
  launchctl bootout "$(uid_target)/${LABEL}" 2>/dev/null || true
  launchctl bootstrap "$(uid_target)" "$PLIST" || die "launchctl bootstrap failed"
  say "loaded ${LABEL}"
  say ""
  say "NOTE: the worker will exit 2 until its Keychain item exists."
  say "      run: workerctl enroll ${wid}"
}

cmd_enroll() {
  require_macos; refuse_privilege
  local wid="${1:-}"
  [ -n "$wid" ] || die "usage: workerctl enroll <worker-id>"

  # The TOKEN is read from the terminal with `read -s` and never appears in argv, so it cannot be
  # captured by `ps` or land in shell history. The same applies to the secret it is exchanged for.
  say "Paste the enrollment token (it will not be echoed), then press return:"
  local token; IFS= read -rs token
  [ -n "$token" ] || die "no token given"

  say "exchanging it for a worker secret…"
  WORKER_ENROLL_TOKEN="$token" node "$WORKER_DIR/installer/macos/enroll.js" "$wid" \
    || die "enrolment failed"
  unset WORKER_ENROLL_TOKEN token
  say "stored in the login Keychain. The token is now spent and cannot be reused."
}

cmd_start()   { require_macos; launchctl kickstart "$(uid_target)/${LABEL}" && say "started"; }
cmd_stop()    { require_macos; launchctl bootout "$(uid_target)/${LABEL}" 2>/dev/null; say "stopped"; }
cmd_restart() { require_macos; launchctl kickstart -k "$(uid_target)/${LABEL}" && say "restarted"; }

cmd_status() {
  require_macos
  if [ ! -f "$PLIST" ]; then say "not installed"; return 1; fi
  say "plist : $PLIST"
  launchctl print "$(uid_target)/${LABEL}" 2>/dev/null \
    | grep -E '^\s*(state|pid|last exit code|runs) ' || say "not loaded"
}

cmd_logs() {
  [ -d "$LOG_DIR" ] || die "no log directory at $LOG_DIR"
  say "— $LOG_DIR/worker.log (tail) —"
  tail -n "${1:-50}" "$LOG_DIR/worker.log" 2>/dev/null || say "(empty)"
  if [ -s "$LOG_DIR/worker.err.log" ]; then
    say ""; say "— worker.err.log (tail) —"
    tail -n "${1:-50}" "$LOG_DIR/worker.err.log"
  fi
}

# Reports readiness and contacts nothing. It prints whether the Keychain item EXISTS; it never
# reads or prints its value.
cmd_doctor() {
  local url wid
  url="$(/usr/libexec/PlistBuddy -c 'Print :EnvironmentVariables:WORKER_API_BASE_URL' "$PLIST" 2>/dev/null || true)"
  wid="$(/usr/libexec/PlistBuddy -c 'Print :EnvironmentVariables:WORKER_ID' "$PLIST" 2>/dev/null || true)"
  say "platform        : $(uname -s) $(uname -m)"
  say "node            : $(command -v node || echo 'NOT FOUND') $(node -v 2>/dev/null || true)"
  say "plist installed : $([ -f "$PLIST" ] && echo yes || echo no)"
  say "account         : $(id -un) (admin: $(id -Gn | tr ' ' '\n' | grep -qx admin && echo YES || echo no))"
  say "log dir         : $([ -d "$LOG_DIR" ] && echo "$LOG_DIR" || echo 'absent')"
  say ""
  WORKER_API_BASE_URL="$url" WORKER_ID="$wid" node "$WORKER_DIR/src/worker-client/run.js" --doctor
}

cmd_uninstall() {
  require_macos
  launchctl bootout "$(uid_target)/${LABEL}" 2>/dev/null || true
  rm -f "$PLIST"
  say "removed the LaunchAgent."
  say ""
  say "LEFT IN PLACE, deliberately:"
  say "  - $LOG_DIR  (the record of what this worker did)"
  say "  - the Keychain item"
  say ""
  say "The credential is left because removing it here would make uninstall a destructive act with"
  say "no confirmation. REVOKE THE IDENTITY SERVER-SIDE — that is what actually ends this worker's"
  say "access; deleting the local copy only makes it stop working."
  say "  then, if you want the local item gone:  security delete-generic-password -s ai.playnexa.worker"
}

case "${1:-}" in
  install)   shift; cmd_install "$@" ;;
  enroll)    shift; cmd_enroll "$@" ;;
  start)     cmd_start ;;
  stop)      cmd_stop ;;
  restart)   cmd_restart ;;
  status)    cmd_status ;;
  logs)      shift; cmd_logs "$@" ;;
  doctor)    cmd_doctor ;;
  uninstall) cmd_uninstall ;;
  *)
    cat <<USAGE
PlayNexa worker control

  workerctl install <https-api-base-url> <wkr_id>   write and load the LaunchAgent
  workerctl enroll  <wkr_id>                        exchange an enrollment token for a secret
  workerctl start | stop | restart                  control the service
  workerctl status                                  launchd state, pid, last exit code
  workerctl logs [lines]                            tail the worker log
  workerctl doctor                                  readiness; contacts nothing
  workerctl uninstall                               remove the LaunchAgent

NOT TESTED ON macOS. See the header of this file.
USAGE
    exit 64 ;;
esac
