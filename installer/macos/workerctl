#!/usr/bin/env bash
# ── PlayNexa worker control ──────────────────────────────────────────────────
#
#   workerctl enroll    <api-base-url>              FIRST  — token in, worker identity out
#   workerctl install   <api-base-url> <worker-id>  SECOND — write the LaunchAgent and load it
#   workerctl start | stop | restart | status | logs | doctor | uninstall
#
# ── WRITTEN BUT NOT EXECUTED ON APPLE HARDWARE ──────────────────────────────
#
# Every line below was syntax-checked with `bash -n` and the plist it generates was parsed, both on
# LINUX. Nothing here has run on macOS. `launchctl`, `security` and `sysadminctl` do not exist in
# that environment, so their invocations are unverified by execution and must be treated as
# untested until somebody runs them on the machine. Said plainly because an installer that LOOKS
# tested is worse than one that admits it is not.
#
# ── IT WILL NOT CREATE THE ACCOUNT FOR YOU ──────────────────────────────────
#
# Creating a macOS user needs admin rights, and a script that quietly creates an account is a
# script that quietly creates an account. The owner does that once, by hand, and this refuses to
# run as root or as an admin so it cannot be the thing that did it.
#
# ── IT ENABLES NOTHING INBOUND ──────────────────────────────────────────────
#
# No SSH, no Remote Management, no Screen Sharing, no firewall change, no port. The worker only
# makes outbound connections. If a future version of this file needs an inbound anything, that is
# a design change and not an installer detail.

set -uo pipefail

LABEL="ai.playnexa.worker"
# ── DEFECT 5 (found on the office iMac, 2026-11-17) ─────────────────────────
#
# The Keychain SERVICE is the label; the ACCOUNT is NOT. src/worker-client/keychain.js writes
# `-s ai.playnexa.worker -a worker-secret:<wkr_id>`, and this script used to look under
# `-a ai.playnexa.worker:<wkr_id>`. The item was therefore never found, and a correct install
# printed "there is NO Keychain secret for <id> … The worker will exit 2 on every launch" while
# the worker was running perfectly — advice which, followed, burns a fresh enrolment token per
# attempt and fixes nothing.
#
# Named once here, and kept honest by src/worker-client/workerctl-keychain-naming.test.js, which
# fails if this literal and ACCOUNT_LABEL in keychain.js ever disagree again.
SECRET_ACCOUNT_PREFIX="worker-secret"
PLIST="$HOME/Library/LaunchAgents/${LABEL}.plist"
LOG_DIR="$HOME/Library/Logs/playnexa-worker"
HERE="$(cd "$(dirname "$0")" && pwd)"
WORKER_DIR="$(cd "$HERE/../.." && pwd)"
TEMPLATE="$HERE/${LABEL}.plist.template"

die() { printf 'error: %s\n' "$*" >&2; exit 1; }
say() { printf '%s\n' "$*"; }

require_macos() {
  [ "$(uname -s)" = "Darwin" ] || die "this runs on macOS only; this is $(uname -s)"
}

# Refuses root AND admin. The worker account should be a plain user: if it is in the admin group,
# anything that compromises the worker has local administrative rights on the machine.
refuse_privilege() {
  [ "$(id -u)" != "0" ] || die "do not run this as root. The worker is a plain user account."
  if id -Gn 2>/dev/null | tr ' ' '\n' | grep -qx admin; then
    die "$(id -un) is in the 'admin' group. Create a dedicated NON-admin account for the worker and run this as that account. See installer/macos/README.md."
  fi
}

uid_target() { printf 'gui/%s' "$(id -u)"; }

# ── DEFECT 7 (found on the office iMac, 2026-11-18) ─────────────────────────
#
# `cmd_install` used to boot out a RUNNING agent and bootstrap immediately. launchd had not
# finished removing the job, so bootstrap failed with
#
#     Bootstrap failed: 5: Input/output error
#
# which names nothing that is actually wrong. The log timestamps settled it: SIGTERM at
# 23:51:47.476Z, the process exiting at 23:51:48.887Z, and bootstrap attempted in the 1.4s
# between. A retry minutes later succeeded — because time had passed, not because of anything
# the operator did in between. Worse, `wrote $PLIST` had already printed, so the machine was left
# holding a NEW plist with NO loaded agent.
#
# After bootout, wait until launchd agrees the label is gone, with a bound. On timeout, report
# what launchd actually says rather than guessing at a cause.
TEARDOWN_TIMEOUT_S="${WORKERCTL_TEARDOWN_TIMEOUT_S:-120}"
STOP_TIMEOUT_S="${WORKERCTL_STOP_TIMEOUT_S:-120}"

job_loaded() { launchctl print "$(uid_target)/${LABEL}" >/dev/null 2>&1; }

# Scoped to this uid and to run.js, so it cannot match another account's worker. `|| true` because
# pgrep exits 1 on no match and that is the normal, expected case.
worker_pids() { pgrep -u "$(id -u)" -f 'worker-client/run\.js' 2>/dev/null || true; }

# 0 = launchd no longer holds the label. 1 = it still did when the bound expired.
wait_for_teardown() {
  local waited=0
  while job_loaded; do
    [ "$waited" -lt "$TEARDOWN_TIMEOUT_S" ] || return 1
    sleep 1
    waited=$((waited + 1))
  done
  return 0
}

report_stuck_job() {
  say "launchctl still reports ${LABEL} after ${TEARDOWN_TIMEOUT_S}s:"
  launchctl print "$(uid_target)/${LABEL}" 2>&1 \
    | grep -E '^[[:space:]]*(state|pid|last exit code) ' || say "  (launchctl print said nothing useful)"
}

cmd_install() {
  require_macos; refuse_privilege
  local url="${1:-}" wid="${2:-}"
  [ -n "$url" ] && [ -n "$wid" ] || die "usage: workerctl install <api-base-url> <worker-id> [--env development|production] [--crash-test]"
  case "$url" in https://*) ;; *) die "the API base URL must be https://" ;; esac
  case "$wid" in wkr_*) ;; *) die "the worker id must look like wkr_<32 hex>" ;; esac
  shift 2

  # ── EXPLICIT ENVIRONMENT, DEFAULTING TO PRODUCTION ────────────────────────
  #
  # Unstated means production. That is the direction that fails safe: a worker installed without
  # a decision cannot take any development-only path, and nothing is inferred from the URL (the
  # dev API's own hostname contains the word "production" — see the plist template).
  # Arming is time-boxed. See the ARMED_SHAPE comment in handlers/synthetic-crash-test.js: a
  # deadline is the only form of "disarmed on interruption" that survives the operator's terminal
  # dying, the Mac rebooting, or everyone going home.
  local worker_env="production" crash_test="no" crash_minutes="120"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --env)         shift; worker_env="${1:-}" ;;
      --env=*)       worker_env="${1#--env=}" ;;
      --crash-test)       crash_test="yes" ;;
      --crash-test=*)     crash_test="yes"; crash_minutes="${1#--crash-test=}" ;;
      *) die "unknown install option: $1
  usage: workerctl install <api-base-url> <worker-id> [--env development|production] [--crash-test]" ;;
    esac
    shift
  done
  case "$worker_env" in
    development|production) ;;
    *) die "--env must be exactly 'development' or 'production' (got '${worker_env}')" ;;
  esac
  if [ "$crash_test" = "yes" ] && [ "$worker_env" != "development" ]; then
    die "--crash-test requires --env development.
  It arms the M7.5 scenario-7 handshake, which makes the worker SIGKILL itself when it leases a
  synthetic.crash_test task. That belongs nowhere near a production worker."
  fi
  case "$crash_minutes" in
    ''|*[!0-9]*) die "--crash-test=<minutes> must be a whole number of minutes (got '${crash_minutes}')" ;;
  esac
  if [ "$crash_minutes" -lt 1 ] || [ "$crash_minutes" -gt 1440 ]; then
    die "--crash-test=<minutes> must be between 1 and 1440. An arming window longer than a day is
  not a test window, it is a standing capability."
  fi

  local node_bin; node_bin="$(command -v node)" || die "node is not on PATH"
  [ -f "$TEMPLATE" ] || die "missing template: $TEMPLATE"

  mkdir -p "$LOG_DIR" "$HOME/Library/LaunchAgents" || die "could not create the log or LaunchAgents directory"

  # Written to a temp file and moved, so an interrupted install never leaves a half-written plist
  # that launchd would then refuse in a confusing way.
  local tmp; tmp="$(mktemp)" || die "mktemp failed"

  # The crash-test arming variable is written ONLY when asked for, and its value is this worker's
  # own id rather than a boolean — so a variable left behind on one machine cannot arm a different
  # worker, and re-enrolling (which changes the id) disarms it. Default installs contain no such
  # key at all, which the rendering tests assert.
  local extra; extra="$(mktemp)" || { rm -f "$tmp"; die "mktemp failed"; }
  : > "$extra"
  local crash_deadline=''
  if [ "$crash_test" = "yes" ]; then
    crash_deadline="$(( $(date +%s) + (crash_minutes * 60) ))"
    printf '    <key>WORKER_ALLOW_CRASH_TEST</key>\n    <string>%s:%s</string>\n' \
      "$wid" "$crash_deadline" >> "$extra"
  fi

  sed -e "s|__NODE_BIN__|${node_bin}|g" \
      -e "s|__WORKER_DIR__|${WORKER_DIR}|g" \
      -e "s|__API_BASE_URL__|${url}|g" \
      -e "s|__WORKER_ID__|${wid}|g" \
      -e "s|__WORKER_ENV__|${worker_env}|g" \
      -e "s|__LOG_DIR__|${LOG_DIR}|g" \
      -e "/__ENV_EXTRA__/r ${extra}" \
      -e "/__ENV_EXTRA__/d" \
      "$TEMPLATE" > "$tmp" || { rm -f "$extra"; die "could not render the plist"; }
  rm -f "$extra"

  plutil -lint "$tmp" >/dev/null || { rm -f "$tmp"; die "the rendered plist is not valid"; }
  mv "$tmp" "$PLIST" || die "could not install the plist"
  chmod 644 "$PLIST"
  say "wrote $PLIST"
  say "environment : ${worker_env}"
  if [ "$crash_test" = "yes" ]; then
    say "crash test  : ARMED for ${wid} — a synthetic.crash_test task will SIGKILL this worker."
    say "              Expires in ${crash_minutes} minute(s), at $(date -r "$crash_deadline" '+%Y-%m-%d %H:%M:%S %Z' 2>/dev/null || echo "epoch ${crash_deadline}")."
    say "              After that it refuses even if nobody disarms it. To disarm now:"
    say "                workerctl disarm"
  fi

  # Idempotent: bootout first, ignoring the failure when it was not loaded. Then WAIT — see
  # DEFECT 7 above. bootout returns before launchd has finished, and bootstrapping into a domain
  # that still holds the label fails with an error that reads like a broken machine.
  if job_loaded; then
    say "an agent is already loaded; booting it out and waiting for launchd to release the label"
    launchctl bootout "$(uid_target)/${LABEL}" 2>/dev/null || true
  fi
  if ! wait_for_teardown; then
    report_stuck_job
    die "launchd has not released ${LABEL}, so bootstrap would fail with 'Input/output error'.
  The previous agent is still shutting down. The new plist IS written; re-run
  'workerctl install' once 'workerctl status' reports it gone."
  fi
  launchctl bootstrap "$(uid_target)" "$PLIST" || die "launchctl bootstrap failed.
  The label was confirmed absent first, so this is not the teardown race. Check whether the
  label is disabled: launchctl print-disabled $(uid_target) | grep ${LABEL}
  If it is, 'launchctl enable $(uid_target)/${LABEL}' and install again."
  say "loaded ${LABEL}"
  say ""
  # Install is the SECOND step. If the Keychain item is missing, enrolment either has not happened
  # or produced a different id than the one just written into the plist — and the second case is the
  # one worth catching, because the worker would simply exit 2 in a loop and the plist would look
  # perfectly correct.
  if security find-generic-password -s "${LABEL}" -a "${SECRET_ACCOUNT_PREFIX}:${wid}" >/dev/null 2>&1; then
    say "The Keychain holds a secret for ${wid}. The worker can start."
  else
    say "WARNING: there is NO Keychain secret for ${wid}."
    say "         The worker will exit 2 on every launch until there is one."
    say "         Enrol first, then install with the id enrolment printed:"
    say "           workerctl enroll ${url}"
    say "         If you have already enrolled, the id does not match what you enrolled as."
  fi
}

# ── ENROL FIRST, INSTALL SECOND ─────────────────────────────────────────────
#
# This took a <worker-id> argument and passed NO URL to enroll.js, which requires one. Both halves
# were wrong:
#
#   - enroll.js reads its URL from --url or WORKER_API_BASE_URL. This passed neither, and nothing
#     sets that variable, so EVERY enrolment would have failed with "no API base URL".
#   - the worker id does not exist before enrolment. The SERVER assigns it in exchange for the
#     token. Demanding it as an argument made the first run impossible.
#
# So the URL is the required argument, and the id is an optional guard for re-enrolling an identity
# you already have. Enrolment creates the identity and PRINTS its id; install then consumes it.
cmd_enroll() {
  require_macos; refuse_privilege
  local url="${1:-}" wid='' token_file=''
  if [ -z "$url" ]; then
    die "usage: workerctl enroll <api-base-url> [existing-worker-id] [--token-file <path>]
  The URL is required: enrolment is a request TO the API, and the worker id does not
  exist until that request returns it. Enrol first, then install with the id it prints."
  fi
  case "$url" in
    https://*) ;;
    http://127.0.0.1*|http://localhost*) say "NOTE: enrolling over loopback HTTP — tests only." ;;
    *) die "the API base URL must be https:// (loopback http is permitted for tests only)" ;;
  esac
  shift

  # The worker id is optional and the flags may come in any order, so the id is recognised by SHAPE
  # rather than by position. Taking $2 as the id unconditionally would have made
  # `workerctl enroll <url> --token-file f` die with "the optional worker id must look like wkr_…".
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --token-file)   shift; token_file="${1:-}"; [ -n "$token_file" ] || die "--token-file needs a path" ;;
      --token-file=*) token_file="${1#--token-file=}"; [ -n "$token_file" ] || die "--token-file needs a path" ;;
      wkr_*)          wid="$1" ;;
      *) die "unknown enroll argument: $1
  usage: workerctl enroll <api-base-url> [existing-worker-id] [--token-file <path>]" ;;
    esac
    shift
  done

  # ── HOW THE TOKEN GETS IN ─────────────────────────────────────────────────
  #
  # A silent `read -rs` was the only way in, and on 2026-11-18 it cost three failed attempts and
  # one wasted token. macOS Terminal sends bracketed-paste markers; zsh re-enables that at every
  # prompt, so disabling it once does nothing; a silent read echoes nothing, so a mangled paste is
  # indistinguishable from a good one until the API answers. One attempt sent 112 bytes — the token
  # plus 43 bytes of adjacent screen text — and the only reason we found out was that the API
  # distinguishes `unknown_token` from `token_expired`.
  #
  # So --token-file reads the token from a file and EXTRACTS it by shape, then checks the length
  # BEFORE spending it. The token still never appears in argv (only the path does), so `ps` and
  # shell history are no worse off than before, and the file is the caller's to remove.
  local token=''
  if [ -n "$token_file" ]; then
    [ -f "$token_file" ] || die "no such token file: $token_file"
    token="$(grep -oE 'wet_[A-Za-z0-9]{64}' "$token_file" | head -1)"
    if [ -z "$token" ]; then
      die "no enrollment token found in $token_file.
  Expected a wet_ token of 68 characters somewhere in the file. The file holds $(wc -c < "$token_file" | tr -d ' ') byte(s),
  which is reported instead of its contents on purpose."
    fi
    say "read a ${#token}-character token from ${token_file} (not echoed)"
  else
    say "Paste the enrollment token (it will not be echoed), then press return:"
    IFS= read -rs token
    say ""
    [ -n "$token" ] || die "no token given"
    # Length only. A token of the wrong length is a mangled paste, and saying so before the request
    # is the difference between one retry and three.
    if [ "${#token}" -ne 68 ]; then
      die "that is ${#token} characters; an enrollment token is 68.
  Almost certainly a mangled paste — bracketed-paste markers, or surrounding text that came along
  with it. Nothing was sent, so the token is unspent. Try again, or use:
      workerctl enroll $url --token-file <file>"
    fi
  fi

  say "exchanging it for a worker secret…"
  if [ -n "$wid" ]; then
    WORKER_ENROLL_TOKEN="$token" node "$WORKER_DIR/installer/macos/enroll.js" --url "$url" "$wid" \
      || die "enrolment failed"
  else
    WORKER_ENROLL_TOKEN="$token" node "$WORKER_DIR/installer/macos/enroll.js" --url "$url" \
      || die "enrolment failed"
  fi
  unset WORKER_ENROLL_TOKEN token
  say ""
  say "The token is now spent and cannot be reused."
  say "Next, with the worker id printed above:"
  say "  workerctl install $url <that-wkr_id>"
}

cmd_start()   { require_macos; launchctl kickstart "$(uid_target)/${LABEL}" && say "started"; }
cmd_restart() { require_macos; launchctl kickstart -k "$(uid_target)/${LABEL}" && say "restarted"; }

# ── DEFECT 8 (found the same morning, 2026-11-18) ───────────────────────────
#
# This printed "stopped" unconditionally, immediately after `bootout`. The first stop of the day
# printed it while `status` still showed `state = SIGTERMed`, `pid = 5277`, `last exit code =
# (never exited)`. The word was a statement about having issued a command, not about anything
# having stopped — which is the whole defect class this repo keeps finding.
#
# "Stopped" now means two things, both checked: launchd no longer holds the label, AND no worker
# process survives. Either one unmet is a non-zero exit, because a caller that goes on to install
# over a still-running agent walks straight into DEFECT 7.
cmd_stop() {
  require_macos
  local before; before="$(worker_pids | tr '\n' ' ')"

  launchctl bootout "$(uid_target)/${LABEL}" 2>/dev/null || true

  if ! wait_for_teardown; then
    report_stuck_job
    say "NOT stopped: launchd still holds ${LABEL}."
    return 1
  fi

  # The label being gone does not mean the process is gone. A worker mid-request, or one ignoring
  # SIGTERM, outlives its job entry.
  local waited=0 remaining
  remaining="$(worker_pids | tr '\n' ' ')"
  while [ -n "${remaining// /}" ]; do
    if [ "$waited" -ge "$STOP_TIMEOUT_S" ]; then
      say "NOT stopped: worker process(es) still running after ${STOP_TIMEOUT_S}s: ${remaining}"
      say "  The LaunchAgent is unloaded, so launchd will not restart them, but they are alive."
      return 1
    fi
    sleep 1
    waited=$((waited + 1))
    remaining="$(worker_pids | tr '\n' ' ')"
  done

  if [ -n "${before// /}" ]; then
    say "stopped (pid(s) ${before}exited after ${waited}s)"
  else
    say "stopped (nothing was running)"
  fi
  return 0
}

# ── DISARM, EXPLICITLY AND IMMEDIATELY ──────────────────────────────────────
#
# The deadline in the arming value means an abandoned run disarms itself. This is the other half:
# the deliberate "we are finished testing" step, which should not require remembering the install
# command, the URL or the worker id.
#
# It re-renders the plist from what the plist already says, minus the arming key, and then CHECKS
# that the key is gone — because "I ran the disarm command" is not the same claim as "this worker
# is disarmed", and this file has already been caught making that substitution twice.
cmd_disarm() {
  require_macos; refuse_privilege
  [ -f "$PLIST" ] || die "not installed; there is nothing to disarm"

  local url wid penv armed
  armed="$(plist_value WORKER_ALLOW_CRASH_TEST '.')"
  if [ -z "$armed" ]; then
    say "already disarmed — the plist has no WORKER_ALLOW_CRASH_TEST key."
    return 0
  fi
  url="$(plist_value WORKER_API_BASE_URL '^https?://[A-Za-z0-9._:/-]+$')"
  wid="$(plist_value WORKER_ID '^wkr_[0-9a-f]{32}$')"
  penv="$(plist_value PLAYNEXA_WORKER_ENV '^(development|production)$')"
  [ -n "$url" ] && [ -n "$wid" ] || die "could not read the API URL and worker id back from $PLIST.
  Disarm by reinstalling explicitly:  workerctl install <url> <wkr_id> --env development"

  say "disarming ${wid} (was armed: ${armed})"
  cmd_install "$url" "$wid" --env "${penv:-production}" || die "the reinstall failed; the worker may still be armed — check 'workerctl doctor'"

  if [ -n "$(plist_value WORKER_ALLOW_CRASH_TEST '.')" ]; then
    die "the plist STILL contains WORKER_ALLOW_CRASH_TEST after disarming. Do not leave it: edit
  $PLIST by hand, remove that key, and run 'workerctl install' again."
  fi
  say ""
  say "disarmed: WORKER_ALLOW_CRASH_TEST is absent from the plist."
}

cmd_status() {
  require_macos
  if [ ! -f "$PLIST" ]; then say "not installed"; return 1; fi
  say "plist : $PLIST"
  launchctl print "$(uid_target)/${LABEL}" 2>/dev/null \
    | grep -E '^\s*(state|pid|last exit code|runs) ' || say "not loaded"
}

cmd_logs() {
  [ -d "$LOG_DIR" ] || die "no log directory at $LOG_DIR"
  say "— $LOG_DIR/worker.log (tail) —"
  tail -n "${1:-50}" "$LOG_DIR/worker.log" 2>/dev/null || say "(empty)"
  if [ -s "$LOG_DIR/worker.err.log" ]; then
    say ""; say "— worker.err.log (tail) —"
    tail -n "${1:-50}" "$LOG_DIR/worker.err.log"
  fi
}

# ── READINESS. CONTACTS NOTHING. NEVER READS OUT THE CREDENTIAL. ────────────
#
# This used to report the Keychain as present/absent. A boolean cannot say "the credential IS there
# and macOS refused to release it", which on macOS 26.4 and later is a real and persistent state
# (errSecAuthFailed / -25293) — and reporting it as absent sends you to re-enrol, which spends a
# single-use token and fixes nothing. The four states are now distinguished, with the real macOS
# status preserved, and the value itself is never read out.
# ── READING A VALUE OUT OF THE PLIST, WITHOUT BELIEVING THE TOOL ────────────
#
# On a machine with no plist, `PlistBuddy -c Print …` prints
#
#     File Doesn't Exist, Will Create: /Users/<you>/Library/LaunchAgents/ai.playnexa.worker.plist
#
# on STDOUT, not stderr, and exits 0. So `v="$(PlistBuddy … 2>/dev/null || true)"` captured that
# sentence AS THE VALUE. The first run of `workerctl doctor` on real hardware fed it to the
# diagnostic as both the API URL and the worker id, which then reported `baseUrlConfigured: true`
# for a URL that was an error message.
#
# So: do not call PlistBuddy at all unless the file exists, and validate the shape of whatever comes
# back rather than trusting it. A value that does not match is discarded, not passed on — a wrong
# value is worse than no value, because no value is reported honestly as "not configured".
# The absolute path is deliberate: PlistBuddy lives there on every macOS and resolving it through
# PATH would let anything earlier on PATH answer questions about the LaunchAgent. The override
# exists so the test harness can drive this file on Linux, where PlistBuddy does not exist at all —
# without it, `disarm` and `doctor` would report "nothing to do" off-darwin and their tests would
# pass by never reaching the code under test. Nothing in production sets it.
PLISTBUDDY="${WORKERCTL_PLISTBUDDY:-/usr/libexec/PlistBuddy}"

plist_value() {
  local key="$1" shape="$2" v
  [ -f "$PLIST" ] || return 0
  v="$("$PLISTBUDDY" -c "Print :EnvironmentVariables:${key}" "$PLIST" 2>/dev/null)" || return 0
  v="$(printf '%s' "$v" | tr -d '\r' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
  case "$v" in
    *"Doesn't Exist"*|*'Does Not Exist'*|*'Will Create'*) return 0 ;;
  esac
  printf '%s' "$v" | grep -Eq "$shape" || return 0
  printf '%s' "$v"
}

cmd_doctor() {
  local url wid out state status detail recovery
  url="$(plist_value WORKER_API_BASE_URL '^https?://[A-Za-z0-9._:-]+')"
  wid="$(plist_value WORKER_ID '^wkr_[0-9a-f]{32}$')"
  say "platform        : $(uname -s) $(uname -m) $(sw_vers -productVersion 2>/dev/null || true)"
  say "node            : $(command -v node || echo 'NOT FOUND') $(node -v 2>/dev/null || true)"
  say "plist installed : $([ -f "$PLIST" ] && echo yes || echo no)"
  say "account         : $(id -un) (admin: $(id -Gn | tr ' ' '\n' | grep -qx admin && echo YES || echo no))"
  say "log dir         : $([ -d "$LOG_DIR" ] && echo "$LOG_DIR" || echo 'absent')"
  # The environment label and the crash-test arming are both invisible otherwise, and an armed
  # worker left behind after an acceptance run is a machine that will SIGKILL itself the next time
  # a crash_test task appears in the queue. Reported here so "is this thing armed?" never has to be
  # answered by reading a plist by hand.
  local penv armed
  penv="$(plist_value PLAYNEXA_WORKER_ENV '^(development|production)$')"
  armed="$(plist_value WORKER_ALLOW_CRASH_TEST '^wkr_[0-9a-f]{32}:[0-9]{10,}$')"
  say "environment     : ${penv:-not labelled (treated as production)}"
  if [ -n "$armed" ]; then
    local armed_id armed_until now_s
    armed_id="${armed%%:*}"
    armed_until="${armed##*:}"
    now_s="$(date +%s)"
    if [ "$armed_id" != "$wid" ]; then
      say "crash test      : arms ${armed_id}, which is NOT this worker (${wid:-none}) — inert."
    elif [ "$now_s" -gt "$armed_until" ]; then
      say "crash test      : EXPIRED at $(date -r "$armed_until" '+%Y-%m-%d %H:%M:%S %Z' 2>/dev/null || echo "epoch ${armed_until}") — refuses, but the key is still in the plist."
      say "                  Tidy it with: workerctl disarm"
    else
      say "crash test      : ARMED for this worker until $(date -r "$armed_until" '+%Y-%m-%d %H:%M:%S %Z' 2>/dev/null || echo "epoch ${armed_until}")"
      say "                  ($(( (armed_until - now_s) / 60 )) minute(s) left). A synthetic.crash_test task will SIGKILL it."
      say "                  Disarm now with: workerctl disarm"
    fi
  elif [ -n "$(plist_value WORKER_ALLOW_CRASH_TEST '.')" ]; then
    # Present but not in wid:deadline form — the handler refuses it, and saying "not armed" would
    # be a measurement of the regex rather than of the plist.
    say "crash test      : a WORKER_ALLOW_CRASH_TEST key is present but MALFORMED — the handler"
    say "                  refuses it. Clear it with: workerctl disarm"
  else
    say "crash test      : not armed"
  fi
  say ""

  out="$(WORKER_API_BASE_URL="$url" WORKER_ID="$wid" \
    node "$WORKER_DIR/src/worker-client/run.js" --doctor 2>&1)"
  printf '%s\n' "$out"

  # Pull the fields back out and say what they mean, because a JSON blob is not an answer to
  # "why will the worker not start".
  state="$(printf '%s' "$out" | sed -n 's/.*"keychainState": *"\([^"]*\)".*/\1/p' | head -1)"
  status="$(printf '%s' "$out" | sed -n 's/.*"keychainStatus": *\([^,}]*\).*/\1/p' | head -1)"
  detail="$(printf '%s' "$out" | sed -n 's/.*"keychainDetail": *"\([^"]*\)".*/\1/p' | head -1)"
  recovery="$(printf '%s' "$out" | sed -n 's/.*"keychainRecovery": *"\([^"]*\)".*/\1/p' | head -1)"

  # ── EVERY BRANCH ENDS ON A DEFINITE SUCCESS ───────────────────────────────
  #
  # These were written as `[ -n "$x" ] && say …` chains. With no `set -e` that does not abort, but
  # the chain's exit status becomes the FUNCTION's exit status when it is the last statement in a
  # branch — so `workerctl doctor; echo "exit=$?"` printed exit=1 whenever an optional field
  # happened to be empty. A diagnostic that reports failure because a field was blank teaches the
  # operator to ignore its exit code, which is the one thing it must not do.
  #
  # Hence: `if` statements, and an explicit `return 0` at the end.
  say ""
  say "── credential ──"
  case "$state" in
    readable)
      say "  READABLE. The worker can start."
      ;;
    missing)
      say "  MISSING. No credential is stored for this worker id."
      say "  Enrol it:  workerctl enroll ${url:-<https-api-base-url>}"
      ;;
    unreadable)
      say "  PRESENT BUT UNREADABLE — macOS refused the read (status ${status:-unknown})."
      say "  THIS IS NOT 'not enrolled'. Re-enrolling spends a single-use token and will not fix it."
      if [ -n "$detail" ]; then say "  macOS said: $detail"; fi
      if [ -n "$recovery" ]; then say "  $recovery"; fi
      ;;
    not_configured)
      # The normal state before enrolment. It is not a fault and must not be dressed as one.
      # The detail is deliberately NOT echoed here: it says the same thing as the line above, and a
      # diagnostic that repeats itself reads as though two separate things were wrong.
      say "  NOT CONFIGURED. No worker id is set, so no Keychain lookup was attempted."
      say "  This is expected before enrolment. Enrol first — that assigns the worker id — then"
      say "  install with the id it prints:"
      say "    workerctl enroll ${url:-<https-api-base-url>}"
      ;;
    unknown)
      say "  UNKNOWN (status ${status:-unknown}). A lookup WAS attempted and failed in a way this"
      say "  tool does not recognise, so NOTHING is concluded about whether the credential exists."
      # "macOS said" only when macOS actually said it — i.e. a real call returned a status. Our own
      # explanatory text was previously printed under that label, which is a small lie that would
      # send someone hunting a macOS problem that did not exist.
      if [ -n "$detail" ]; then
        if [ -n "$status" ] && [ "$status" != "null" ]; then
          say "  macOS said: $detail"
        else
          say "  $detail"
        fi
      fi
      say "  Do not re-enrol on the strength of this. Run the lookup by hand and report the output:"
      if [ -n "$wid" ]; then
        say "    security find-generic-password -s ${LABEL} -a ${SECRET_ACCOUNT_PREFIX}:${wid}"
      else
        say "    (no worker id is known, so there is no lookup to run by hand)"
      fi
      ;;
    not_macos)
      say "  NOT APPLICABLE. This is not macOS, so the Keychain was not consulted."
      ;;
    *)
      say "  could not determine the credential state from the diagnostic output above"
      ;;
  esac
  return 0
}

cmd_uninstall() {
  require_macos
  launchctl bootout "$(uid_target)/${LABEL}" 2>/dev/null || true
  rm -f "$PLIST"
  say "removed the LaunchAgent."
  say ""
  say "LEFT IN PLACE, deliberately:"
  say "  - $LOG_DIR  (the record of what this worker did)"
  say "  - the Keychain item"
  say ""
  say "The credential is left because removing it here would make uninstall a destructive act with"
  say "no confirmation. REVOKE THE IDENTITY SERVER-SIDE — that is what actually ends this worker's"
  say "access; deleting the local copy only makes it stop working."
  say "  then, if you want the local item gone:  security delete-generic-password -s ai.playnexa.worker"
}

# Sourcing with WORKERCTL_LIB=1 defines the functions without dispatching, so the shell logic in
# this file can be tested rather than only read. scripts/check-workerctl-doctor.js does that.
if [ "${WORKERCTL_LIB:-}" = "1" ]; then return 0 2>/dev/null || true; fi

case "${1:-}" in
  install)   shift; cmd_install "$@" ;;
  enroll)    shift; cmd_enroll "$@" ;;
  start)     cmd_start ;;
  stop)      cmd_stop ;;
  restart)   cmd_restart ;;
  disarm)    cmd_disarm ;;
  status)    cmd_status ;;
  logs)      shift; cmd_logs "$@" ;;
  doctor)    cmd_doctor ;;
  uninstall) cmd_uninstall ;;
  *)
    cat <<USAGE
PlayNexa worker control

  workerctl enroll  <https-api-base-url> [wkr_id]   FIRST:  token in, worker identity out
  workerctl install <https-api-base-url> <wkr_id>   SECOND: write and load the LaunchAgent
  workerctl start | stop | restart                  control the service
  workerctl disarm                                  remove the crash-test arming now
  workerctl status                                  launchd state, pid, last exit code
  workerctl logs [lines]                            tail the worker log
  workerctl doctor                                  readiness; contacts nothing
  workerctl uninstall                               remove the LaunchAgent

NOT TESTED ON macOS. See the header of this file.
USAGE
    exit 64 ;;
esac
