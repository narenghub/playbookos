#!/usr/bin/env bash
# ── PlayNexa worker control ──────────────────────────────────────────────────
#
#   workerctl enroll    <api-base-url>              FIRST  — token in, worker identity out
#   workerctl install   <api-base-url> <worker-id>  SECOND — write the LaunchAgent and load it
#   workerctl start | stop | restart | status | logs | doctor | uninstall
#
# ── WRITTEN BUT NOT EXECUTED ON APPLE HARDWARE ──────────────────────────────
#
# Every line below was syntax-checked with `bash -n` and the plist it generates was parsed, both on
# LINUX. Nothing here has run on macOS. `launchctl`, `security` and `sysadminctl` do not exist in
# that environment, so their invocations are unverified by execution and must be treated as
# untested until somebody runs them on the machine. Said plainly because an installer that LOOKS
# tested is worse than one that admits it is not.
#
# ── IT WILL NOT CREATE THE ACCOUNT FOR YOU ──────────────────────────────────
#
# Creating a macOS user needs admin rights, and a script that quietly creates an account is a
# script that quietly creates an account. The owner does that once, by hand, and this refuses to
# run as root or as an admin so it cannot be the thing that did it.
#
# ── IT ENABLES NOTHING INBOUND ──────────────────────────────────────────────
#
# No SSH, no Remote Management, no Screen Sharing, no firewall change, no port. The worker only
# makes outbound connections. If a future version of this file needs an inbound anything, that is
# a design change and not an installer detail.

set -uo pipefail

LABEL="ai.playnexa.worker"
# ── DEFECT 5 (found on the office iMac, 2026-11-17) ─────────────────────────
#
# The Keychain SERVICE is the label; the ACCOUNT is NOT. src/worker-client/keychain.js writes
# `-s ai.playnexa.worker -a worker-secret:<wkr_id>`, and this script used to look under
# `-a ai.playnexa.worker:<wkr_id>`. The item was therefore never found, and a correct install
# printed "there is NO Keychain secret for <id> … The worker will exit 2 on every launch" while
# the worker was running perfectly — advice which, followed, burns a fresh enrolment token per
# attempt and fixes nothing.
#
# Named once here, and kept honest by src/worker-client/workerctl-keychain-naming.test.js, which
# fails if this literal and ACCOUNT_LABEL in keychain.js ever disagree again.
SECRET_ACCOUNT_PREFIX="worker-secret"
PLIST="$HOME/Library/LaunchAgents/${LABEL}.plist"
LOG_DIR="$HOME/Library/Logs/playnexa-worker"
HERE="$(cd "$(dirname "$0")" && pwd)"
WORKER_DIR="$(cd "$HERE/../.." && pwd)"
TEMPLATE="$HERE/${LABEL}.plist.template"

die() { printf 'error: %s\n' "$*" >&2; exit 1; }
say() { printf '%s\n' "$*"; }

require_macos() {
  [ "$(uname -s)" = "Darwin" ] || die "this runs on macOS only; this is $(uname -s)"
}

# Refuses root AND admin. The worker account should be a plain user: if it is in the admin group,
# anything that compromises the worker has local administrative rights on the machine.
refuse_privilege() {
  [ "$(id -u)" != "0" ] || die "do not run this as root. The worker is a plain user account."
  if id -Gn 2>/dev/null | tr ' ' '\n' | grep -qx admin; then
    die "$(id -un) is in the 'admin' group. Create a dedicated NON-admin account for the worker and run this as that account. See installer/macos/README.md."
  fi
}

uid_target() { printf 'gui/%s' "$(id -u)"; }

cmd_install() {
  require_macos; refuse_privilege
  local url="${1:-}" wid="${2:-}"
  [ -n "$url" ] && [ -n "$wid" ] || die "usage: workerctl install <api-base-url> <worker-id>"
  case "$url" in https://*) ;; *) die "the API base URL must be https://" ;; esac
  case "$wid" in wkr_*) ;; *) die "the worker id must look like wkr_<32 hex>" ;; esac

  local node_bin; node_bin="$(command -v node)" || die "node is not on PATH"
  [ -f "$TEMPLATE" ] || die "missing template: $TEMPLATE"

  mkdir -p "$LOG_DIR" "$HOME/Library/LaunchAgents" || die "could not create the log or LaunchAgents directory"

  # Written to a temp file and moved, so an interrupted install never leaves a half-written plist
  # that launchd would then refuse in a confusing way.
  local tmp; tmp="$(mktemp)" || die "mktemp failed"
  sed -e "s|__NODE_BIN__|${node_bin}|g" \
      -e "s|__WORKER_DIR__|${WORKER_DIR}|g" \
      -e "s|__API_BASE_URL__|${url}|g" \
      -e "s|__WORKER_ID__|${wid}|g" \
      -e "s|__LOG_DIR__|${LOG_DIR}|g" \
      "$TEMPLATE" > "$tmp" || die "could not render the plist"

  plutil -lint "$tmp" >/dev/null || { rm -f "$tmp"; die "the rendered plist is not valid"; }
  mv "$tmp" "$PLIST" || die "could not install the plist"
  chmod 644 "$PLIST"
  say "wrote $PLIST"

  # Idempotent: bootout first, ignoring the failure when it was not loaded.
  launchctl bootout "$(uid_target)/${LABEL}" 2>/dev/null || true
  launchctl bootstrap "$(uid_target)" "$PLIST" || die "launchctl bootstrap failed"
  say "loaded ${LABEL}"
  say ""
  # Install is the SECOND step. If the Keychain item is missing, enrolment either has not happened
  # or produced a different id than the one just written into the plist — and the second case is the
  # one worth catching, because the worker would simply exit 2 in a loop and the plist would look
  # perfectly correct.
  if security find-generic-password -s "${LABEL}" -a "${SECRET_ACCOUNT_PREFIX}:${wid}" >/dev/null 2>&1; then
    say "The Keychain holds a secret for ${wid}. The worker can start."
  else
    say "WARNING: there is NO Keychain secret for ${wid}."
    say "         The worker will exit 2 on every launch until there is one."
    say "         Enrol first, then install with the id enrolment printed:"
    say "           workerctl enroll ${url}"
    say "         If you have already enrolled, the id does not match what you enrolled as."
  fi
}

# ── ENROL FIRST, INSTALL SECOND ─────────────────────────────────────────────
#
# This took a <worker-id> argument and passed NO URL to enroll.js, which requires one. Both halves
# were wrong:
#
#   - enroll.js reads its URL from --url or WORKER_API_BASE_URL. This passed neither, and nothing
#     sets that variable, so EVERY enrolment would have failed with "no API base URL".
#   - the worker id does not exist before enrolment. The SERVER assigns it in exchange for the
#     token. Demanding it as an argument made the first run impossible.
#
# So the URL is the required argument, and the id is an optional guard for re-enrolling an identity
# you already have. Enrolment creates the identity and PRINTS its id; install then consumes it.
cmd_enroll() {
  require_macos; refuse_privilege
  local url="${1:-}" wid="${2:-}"
  if [ -z "$url" ]; then
    die "usage: workerctl enroll <api-base-url> [existing-worker-id]
  The URL is required: enrolment is a request TO the API, and the worker id does not
  exist until that request returns it. Enrol first, then install with the id it prints."
  fi
  case "$url" in
    https://*) ;;
    http://127.0.0.1*|http://localhost*) say "NOTE: enrolling over loopback HTTP — tests only." ;;
    *) die "the API base URL must be https:// (loopback http is permitted for tests only)" ;;
  esac
  if [ -n "$wid" ]; then
    case "$wid" in wkr_*) ;; *) die "the optional worker id must look like wkr_<32 hex>" ;; esac
  fi

  # The TOKEN is read from the terminal with `read -s` and never appears in argv, so it cannot be
  # captured by `ps` or land in shell history. The same applies to the secret it is exchanged for.
  say "Paste the enrollment token (it will not be echoed), then press return:"
  local token; IFS= read -rs token
  say ""
  [ -n "$token" ] || die "no token given"

  say "exchanging it for a worker secret…"
  if [ -n "$wid" ]; then
    WORKER_ENROLL_TOKEN="$token" node "$WORKER_DIR/installer/macos/enroll.js" --url "$url" "$wid" \
      || die "enrolment failed"
  else
    WORKER_ENROLL_TOKEN="$token" node "$WORKER_DIR/installer/macos/enroll.js" --url "$url" \
      || die "enrolment failed"
  fi
  unset WORKER_ENROLL_TOKEN token
  say ""
  say "The token is now spent and cannot be reused."
  say "Next, with the worker id printed above:"
  say "  workerctl install $url <that-wkr_id>"
}

cmd_start()   { require_macos; launchctl kickstart "$(uid_target)/${LABEL}" && say "started"; }
cmd_stop()    { require_macos; launchctl bootout "$(uid_target)/${LABEL}" 2>/dev/null; say "stopped"; }
cmd_restart() { require_macos; launchctl kickstart -k "$(uid_target)/${LABEL}" && say "restarted"; }

cmd_status() {
  require_macos
  if [ ! -f "$PLIST" ]; then say "not installed"; return 1; fi
  say "plist : $PLIST"
  launchctl print "$(uid_target)/${LABEL}" 2>/dev/null \
    | grep -E '^\s*(state|pid|last exit code|runs) ' || say "not loaded"
}

cmd_logs() {
  [ -d "$LOG_DIR" ] || die "no log directory at $LOG_DIR"
  say "— $LOG_DIR/worker.log (tail) —"
  tail -n "${1:-50}" "$LOG_DIR/worker.log" 2>/dev/null || say "(empty)"
  if [ -s "$LOG_DIR/worker.err.log" ]; then
    say ""; say "— worker.err.log (tail) —"
    tail -n "${1:-50}" "$LOG_DIR/worker.err.log"
  fi
}

# ── READINESS. CONTACTS NOTHING. NEVER READS OUT THE CREDENTIAL. ────────────
#
# This used to report the Keychain as present/absent. A boolean cannot say "the credential IS there
# and macOS refused to release it", which on macOS 26.4 and later is a real and persistent state
# (errSecAuthFailed / -25293) — and reporting it as absent sends you to re-enrol, which spends a
# single-use token and fixes nothing. The four states are now distinguished, with the real macOS
# status preserved, and the value itself is never read out.
# ── READING A VALUE OUT OF THE PLIST, WITHOUT BELIEVING THE TOOL ────────────
#
# On a machine with no plist, `PlistBuddy -c Print …` prints
#
#     File Doesn't Exist, Will Create: /Users/<you>/Library/LaunchAgents/ai.playnexa.worker.plist
#
# on STDOUT, not stderr, and exits 0. So `v="$(PlistBuddy … 2>/dev/null || true)"` captured that
# sentence AS THE VALUE. The first run of `workerctl doctor` on real hardware fed it to the
# diagnostic as both the API URL and the worker id, which then reported `baseUrlConfigured: true`
# for a URL that was an error message.
#
# So: do not call PlistBuddy at all unless the file exists, and validate the shape of whatever comes
# back rather than trusting it. A value that does not match is discarded, not passed on — a wrong
# value is worse than no value, because no value is reported honestly as "not configured".
plist_value() {
  local key="$1" shape="$2" v
  [ -f "$PLIST" ] || return 0
  v="$(/usr/libexec/PlistBuddy -c "Print :EnvironmentVariables:${key}" "$PLIST" 2>/dev/null)" || return 0
  v="$(printf '%s' "$v" | tr -d '\r' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
  case "$v" in
    *"Doesn't Exist"*|*'Does Not Exist'*|*'Will Create'*) return 0 ;;
  esac
  printf '%s' "$v" | grep -Eq "$shape" || return 0
  printf '%s' "$v"
}

cmd_doctor() {
  local url wid out state status detail recovery
  url="$(plist_value WORKER_API_BASE_URL '^https?://[A-Za-z0-9._:-]+')"
  wid="$(plist_value WORKER_ID '^wkr_[0-9a-f]{32}$')"
  say "platform        : $(uname -s) $(uname -m) $(sw_vers -productVersion 2>/dev/null || true)"
  say "node            : $(command -v node || echo 'NOT FOUND') $(node -v 2>/dev/null || true)"
  say "plist installed : $([ -f "$PLIST" ] && echo yes || echo no)"
  say "account         : $(id -un) (admin: $(id -Gn | tr ' ' '\n' | grep -qx admin && echo YES || echo no))"
  say "log dir         : $([ -d "$LOG_DIR" ] && echo "$LOG_DIR" || echo 'absent')"
  say ""

  out="$(WORKER_API_BASE_URL="$url" WORKER_ID="$wid" \
    node "$WORKER_DIR/src/worker-client/run.js" --doctor 2>&1)"
  printf '%s\n' "$out"

  # Pull the fields back out and say what they mean, because a JSON blob is not an answer to
  # "why will the worker not start".
  state="$(printf '%s' "$out" | sed -n 's/.*"keychainState": *"\([^"]*\)".*/\1/p' | head -1)"
  status="$(printf '%s' "$out" | sed -n 's/.*"keychainStatus": *\([^,}]*\).*/\1/p' | head -1)"
  detail="$(printf '%s' "$out" | sed -n 's/.*"keychainDetail": *"\([^"]*\)".*/\1/p' | head -1)"
  recovery="$(printf '%s' "$out" | sed -n 's/.*"keychainRecovery": *"\([^"]*\)".*/\1/p' | head -1)"

  # ── EVERY BRANCH ENDS ON A DEFINITE SUCCESS ───────────────────────────────
  #
  # These were written as `[ -n "$x" ] && say …` chains. With no `set -e` that does not abort, but
  # the chain's exit status becomes the FUNCTION's exit status when it is the last statement in a
  # branch — so `workerctl doctor; echo "exit=$?"` printed exit=1 whenever an optional field
  # happened to be empty. A diagnostic that reports failure because a field was blank teaches the
  # operator to ignore its exit code, which is the one thing it must not do.
  #
  # Hence: `if` statements, and an explicit `return 0` at the end.
  say ""
  say "── credential ──"
  case "$state" in
    readable)
      say "  READABLE. The worker can start."
      ;;
    missing)
      say "  MISSING. No credential is stored for this worker id."
      say "  Enrol it:  workerctl enroll ${url:-<https-api-base-url>}"
      ;;
    unreadable)
      say "  PRESENT BUT UNREADABLE — macOS refused the read (status ${status:-unknown})."
      say "  THIS IS NOT 'not enrolled'. Re-enrolling spends a single-use token and will not fix it."
      if [ -n "$detail" ]; then say "  macOS said: $detail"; fi
      if [ -n "$recovery" ]; then say "  $recovery"; fi
      ;;
    not_configured)
      # The normal state before enrolment. It is not a fault and must not be dressed as one.
      # The detail is deliberately NOT echoed here: it says the same thing as the line above, and a
      # diagnostic that repeats itself reads as though two separate things were wrong.
      say "  NOT CONFIGURED. No worker id is set, so no Keychain lookup was attempted."
      say "  This is expected before enrolment. Enrol first — that assigns the worker id — then"
      say "  install with the id it prints:"
      say "    workerctl enroll ${url:-<https-api-base-url>}"
      ;;
    unknown)
      say "  UNKNOWN (status ${status:-unknown}). A lookup WAS attempted and failed in a way this"
      say "  tool does not recognise, so NOTHING is concluded about whether the credential exists."
      # "macOS said" only when macOS actually said it — i.e. a real call returned a status. Our own
      # explanatory text was previously printed under that label, which is a small lie that would
      # send someone hunting a macOS problem that did not exist.
      if [ -n "$detail" ]; then
        if [ -n "$status" ] && [ "$status" != "null" ]; then
          say "  macOS said: $detail"
        else
          say "  $detail"
        fi
      fi
      say "  Do not re-enrol on the strength of this. Run the lookup by hand and report the output:"
      if [ -n "$wid" ]; then
        say "    security find-generic-password -s ${LABEL} -a ${SECRET_ACCOUNT_PREFIX}:${wid}"
      else
        say "    (no worker id is known, so there is no lookup to run by hand)"
      fi
      ;;
    not_macos)
      say "  NOT APPLICABLE. This is not macOS, so the Keychain was not consulted."
      ;;
    *)
      say "  could not determine the credential state from the diagnostic output above"
      ;;
  esac
  return 0
}

cmd_uninstall() {
  require_macos
  launchctl bootout "$(uid_target)/${LABEL}" 2>/dev/null || true
  rm -f "$PLIST"
  say "removed the LaunchAgent."
  say ""
  say "LEFT IN PLACE, deliberately:"
  say "  - $LOG_DIR  (the record of what this worker did)"
  say "  - the Keychain item"
  say ""
  say "The credential is left because removing it here would make uninstall a destructive act with"
  say "no confirmation. REVOKE THE IDENTITY SERVER-SIDE — that is what actually ends this worker's"
  say "access; deleting the local copy only makes it stop working."
  say "  then, if you want the local item gone:  security delete-generic-password -s ai.playnexa.worker"
}

# Sourcing with WORKERCTL_LIB=1 defines the functions without dispatching, so the shell logic in
# this file can be tested rather than only read. scripts/check-workerctl-doctor.js does that.
if [ "${WORKERCTL_LIB:-}" = "1" ]; then return 0 2>/dev/null || true; fi

case "${1:-}" in
  install)   shift; cmd_install "$@" ;;
  enroll)    shift; cmd_enroll "$@" ;;
  start)     cmd_start ;;
  stop)      cmd_stop ;;
  restart)   cmd_restart ;;
  status)    cmd_status ;;
  logs)      shift; cmd_logs "$@" ;;
  doctor)    cmd_doctor ;;
  uninstall) cmd_uninstall ;;
  *)
    cat <<USAGE
PlayNexa worker control

  workerctl enroll  <https-api-base-url> [wkr_id]   FIRST:  token in, worker identity out
  workerctl install <https-api-base-url> <wkr_id>   SECOND: write and load the LaunchAgent
  workerctl start | stop | restart                  control the service
  workerctl status                                  launchd state, pid, last exit code
  workerctl logs [lines]                            tail the worker log
  workerctl doctor                                  readiness; contacts nothing
  workerctl uninstall                               remove the LaunchAgent

NOT TESTED ON macOS. See the header of this file.
USAGE
    exit 64 ;;
esac
